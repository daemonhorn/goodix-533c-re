# Never commit the proprietary driver or any extracted vendor binaries
extracted_driver/
*.deb
*.so
*.so.*

# Local scratch/venv
.venv/
__pycache__/
*.pyc

# Captured raw images / pcaps (large, and may contain real biometric data)
*.pcapng
*.png
*.pgm
# Except the umockdev test fixture, which is deliberately finger-absent
# (see tests/goodix533c/README.md) -- safe to publish, no biometric data.
!tests/goodix533c/capture.pcapng
*.raw

# Ghidra project files (large, regenerable from the .so)
ghidra_project/
ghidra_run.log

# .deb build output/staging (generated by packaging/build.sh from the
# vendored submodule -- not committed, built fresh or downloaded from
# Releases)
packaging/out/
packaging/goodix-533c-test/usr/share/goodix-533c-test/*.py
packaging/goodix-533c-test/usr/share/doc/goodix-533c-test/LICENSE.upstream
