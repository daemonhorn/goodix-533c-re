#cloud-config
hostname: goodix-re-vm
users:
  - name: re
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILIKxl1ObLzDE2wnIViDfv4UFGcPQ3f35LJjwR/NYweb goodix-533c-re-vm

package_update: true
package_upgrade: false

packages:
  - wireshark-common
  - tshark
  - usbutils
  - build-essential
  - git

runcmd:
  - [ modprobe, usbmon ]
  - [ bash, -c, "echo usbmon >> /etc/modules" ]
  - [ bash, -c, "groupadd -f wireshark" ]
  - [ usermod, -aG, wireshark, re ]
  - [ bash, -c, "chgrp wireshark /dev/usbmon* 2>/dev/null || true" ]
  - [ bash, -c, "echo 'SUBSYSTEM==\"usbmon\", GROUP=\"wireshark\", MODE=\"0640\"' > /etc/udev/rules.d/60-usbmon.rules" ]
  - [ systemctl, enable, --now, ssh ]

power_state:
  mode: reboot
  message: "Rebooting after initial cloud-init provisioning"
  condition: true
